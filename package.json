{
  "name": "swb-stele-prototyp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:stele": "tsc --noEmit && STELE=1 vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc --noEmit",
    "export:stele": "npm run build:stele && cp dist-stele/index.html ../stele-prototyp.html"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lenis": "^1.3.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
